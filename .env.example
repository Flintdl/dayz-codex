# ============================================================================
# DayZ Codex — variáveis de ambiente
# Copie para .env e ajuste. Em prod, use secrets manager (Vault, Doppler, etc).
# ============================================================================

# Porta exposta no host (mapeia para 3000 do container)
HOST_PORT=3000

# Site URL canônica — usada em sitemap.xml e Open Graph.
# Exemplo: https://dayz-codex.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node env — sempre 'production' em deploy real.
NODE_ENV=production

# Telemetria do Next.js — manter desligada em produção (privacy + ruído de log).
NEXT_TELEMETRY_DISABLED=1
